# Backend configuration. All optional; sensible local defaults are used.

# Redis. Locally, a bare host:port. In production, a full connection URL from a
# managed provider (Upstash gives a rediss:// URL with TLS + password).
REDIS_URL=localhost:6380
# REDIS_URL=rediss://default:PASSWORD@your-db.upstash.io:6379

# HTTP port. Most hosts (Render, Fly, Koyeb…) inject this automatically.
PORT=8080

# Comma-separated exact origins allowed to open a WebSocket. Leave empty for
# local dev (same-origin + localhost are allowed). In a split deploy, set this
# to your frontend's URL, e.g. https://songspot.vercel.app
WS_ALLOWED_ORIGINS=

# Comma-separated origins allowed to call the REST API (CORS), or "*".
# Defaults to "*". In a split deploy, set to your frontend's URL to lock it down.
CORS_ORIGIN=*
