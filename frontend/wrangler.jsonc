{
  // Cloudflare Workers static-assets config, so `npx wrangler deploy` serves the
  // built Vite SPA. Build with `pnpm build` first (produces ./dist).
  "name": "songspot",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths so client-side routes like
    // /room/:id and /join/:token work on refresh / direct links.
    "not_found_handling": "single-page-application"
  }
}
